<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>LearnBreak — App Wireframes v2</title>
  <style>
    :root {
      --bg: #f6f7f4;
      --surface: #ffffff;
      --surface-soft: #fbf8ef;
      --ink: #1f2933;
      --muted: #687382;
      --line: #e5e7df;
      --green: #3f8f72;
      --green-dark: #26745a;
      --mint: #dff3ea;
      --sun: #f9c74f;
      --sun-soft: #fef6dc;
      --peach: #ffddd2;
      --peach-soft: #fff1ec;
      --blue: #dcecff;
      --blue-mid: #5ba3f5;
      --purple: #eadcff;
      --purple-mid: #9b6be6;
      --coral: #ff6b6b;
      --coral-soft: #ffeceb;
      --shadow: 0 24px 70px rgba(31, 41, 51, 0.10);
      --shadow-soft: 0 14px 30px rgba(31, 41, 51, 0.07);
      --shadow-card: 0 8px 24px rgba(31,41,51,.06);
      --radius-xl: 34px;
      --radius-lg: 24px;
      --radius-md: 16px;
      --radius-sm: 12px;
      --phone: 390px;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background:
        radial-gradient(circle at top left, rgba(63,143,114,.18), transparent 34%),
        radial-gradient(circle at 80% 10%, rgba(249,199,79,.22), transparent 28%),
        var(--bg);
      color: var(--ink);
      line-height: 1.45;
    }

    a { color: inherit; text-decoration: none; }

    .page {
      width: min(1260px, calc(100% - 32px));
      margin: 0 auto;
      padding: 34px 0 70px;
    }

    /* ── Nav ─────────────────────────────────────── */
    .nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      margin-bottom: 54px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 800;
      font-size: 21px;
      letter-spacing: -0.03em;
    }

    .logo {
      width: 44px; height: 44px;
      border-radius: 15px;
      background: linear-gradient(135deg, var(--green), #7fc7a7);
      color: white;
      display: grid; place-items: center;
      box-shadow: 0 14px 26px rgba(63,143,114,.28);
      font-size: 24px;
    }

    .nav-pills {
      display: flex; gap: 10px; flex-wrap: wrap; justify-content: flex-end;
    }

    .nav-pills a {
      padding: 10px 14px;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: rgba(255,255,255,.7);
      color: var(--muted);
      font-size: 13px;
      font-weight: 650;
      backdrop-filter: blur(8px);
      transition: background .2s;
    }

    .nav-pills a:hover { background: #fff; color: var(--ink); }

    /* ── Hero ────────────────────────────────────── */
    .hero {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      align-items: center;
      gap: 50px;
      margin-bottom: 100px;
    }

    .eyebrow {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 8px 14px; border-radius: 999px;
      background: var(--mint); color: var(--green-dark);
      font-weight: 800; font-size: 13px;
      margin-bottom: 18px;
    }

    h1 {
      font-size: clamp(46px,8vw,78px);
      line-height: 0.95; letter-spacing: -0.07em;
      margin: 0 0 22px;
    }

    .hero p { color: var(--muted); font-size: 20px; max-width: 620px; margin: 0 0 30px; }

    .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; align-items: center; }

    .button {
      border: 0; border-radius: 999px; padding: 15px 22px;
      font-weight: 800; font-size: 15px;
      display: inline-flex; align-items: center; gap: 10px;
      cursor: default;
    }

    .button.primary {
      color: #fff; background: var(--green);
      box-shadow: 0 14px 28px rgba(63,143,114,.30);
    }

    .button.secondary {
      color: var(--ink); background: rgba(255,255,255,.8);
      border: 1px solid var(--line);
    }

    .hero-card {
      background: rgba(255,255,255,.72);
      border: 1px solid rgba(255,255,255,.7);
      border-radius: var(--radius-xl);
      padding: 20px;
      box-shadow: var(--shadow);
      backdrop-filter: blur(18px);
      position: relative;
    }

    /* ── Phones ──────────────────────────────────── */
    .phone {
      width: min(var(--phone), 100%);
      margin: 0 auto;
      border-radius: 42px;
      background: #111827;
      padding: 12px;
      box-shadow: 0 28px 80px rgba(17,24,39,.22);
    }

    .phone-screen {
      background: linear-gradient(180deg, #fbfaf6, #f4f7f0);
      min-height: 680px;
      border-radius: 32px;
      overflow: hidden;
      position: relative;
    }

    .status {
      display: flex; justify-content: space-between;
      padding: 16px 22px 8px;
      font-size: 12px; font-weight: 850; color: #263238;
    }

    .phone-content { padding: 14px 20px 24px; }

    .mini-header {
      display: flex; justify-content: space-between; align-items: center;
      margin-bottom: 18px;
    }

    .avatar-stack { display: flex; }
    .avatar {
      width: 34px; height: 34px; border-radius: 50%;
      background: var(--peach); border: 3px solid #fff;
      margin-left: -8px; display: grid; place-items: center; font-size: 15px;
    }
    .avatar:first-child { margin-left: 0; }

    .screen-title {
      font-size: 29px; line-height: 1.05; letter-spacing: -0.05em;
      margin: 6px 0 8px;
    }

    .screen-subtitle { color: var(--muted); font-size: 14px; margin: 0 0 18px; }

    .progress-track {
      height: 10px; border-radius: 999px; background: #e8eadf;
      overflow: hidden; margin: 18px 0 22px;
    }
    .progress-fill {
      height: 100%; width: 62%; border-radius: 999px;
      background: linear-gradient(90deg, var(--green), #9fd8bd);
    }

    .card {
      background: var(--surface); border: 1px solid var(--line);
      border-radius: var(--radius-lg); padding: 18px;
      box-shadow: var(--shadow-soft);
    }

    .app-row {
      display: flex; align-items: center; justify-content: space-between;
      gap: 12px; padding: 12px 0;
      border-bottom: 1px solid #edf0e9;
    }
    .app-row:last-child { border-bottom: 0; }

    .app-meta { display: flex; align-items: center; gap: 12px; min-width: 0; }

    .app-icon {
      width: 42px; height: 42px; border-radius: 14px;
      display: grid; place-items: center; font-size: 19px; flex: 0 0 auto;
    }

    .app-name { font-weight: 850; font-size: 14px; }
    .app-time { color: var(--muted); font-size: 12px; margin-top: 2px; }

    .toggle {
      width: 48px; height: 28px; border-radius: 999px; padding: 3px;
      background: #d8ddd3; flex: 0 0 auto; display: flex; align-items: center;
    }
    .toggle.on { background: var(--green); }
    .knob {
      width: 22px; height: 22px; border-radius: 50%;
      background: white; box-shadow: 0 4px 10px rgba(0,0,0,.15);
    }
    .toggle.on .knob { margin-left: auto; }

    .floating-note {
      position: absolute; right: -22px; bottom: 70px;
      width: 190px; background: #fff; border: 1px solid var(--line);
      border-radius: 22px; padding: 14px;
      box-shadow: var(--shadow-soft); transform: rotate(2deg);
    }
    .floating-note strong { display: block; font-size: 13px; margin-bottom: 4px; }
    .floating-note span { display: block; color: var(--muted); font-size: 12px; }

    /* ── Sections ────────────────────────────────── */
    .section { margin-bottom: 100px; }

    .section-head {
      display: flex; align-items: end; justify-content: space-between;
      gap: 28px; margin-bottom: 32px;
    }

    h2 {
      font-size: clamp(32px,5vw,52px);
      line-height: 1.02; letter-spacing: -0.06em; margin: 0;
    }

    .section-head p { color: var(--muted); max-width: 470px; margin: 0; font-size: 17px; }

    .section-label {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 7px 14px; border-radius: 999px;
      font-weight: 800; font-size: 12px; letter-spacing: .04em;
      margin-bottom: 14px;
    }

    /* ── Grids ───────────────────────────────────── */
    .grid-3 { display: grid; grid-template-columns: repeat(3,1fr); gap: 18px; }
    .grid-2 { display: grid; grid-template-columns: repeat(2,1fr); gap: 24px; }

    .feature-card {
      background: rgba(255,255,255,.72);
      border: 1px solid rgba(229,231,223,.8);
      border-radius: var(--radius-lg); padding: 24px;
      box-shadow: var(--shadow-card);
    }

    .feature-card .icon {
      width: 48px; height: 48px; border-radius: 17px;
      display: grid; place-items: center;
      margin-bottom: 16px; font-size: 24px;
    }

    .feature-card h3 { margin: 0 0 8px; font-size: 20px; letter-spacing: -0.03em; }
    .feature-card p { margin: 0; color: var(--muted); font-size: 15px; }

    /* ── Flow steps ──────────────────────────────── */
    .flow { display: grid; grid-template-columns: repeat(4,1fr); gap: 14px; }

    .flow-step {
      position: relative;
      background: var(--surface); border: 1px solid var(--line);
      border-radius: var(--radius-lg); padding: 20px;
      min-height: 170px; box-shadow: var(--shadow-card);
    }

    .flow-step .num {
      width: 34px; height: 34px; border-radius: 50%;
      background: var(--mint); color: var(--green-dark);
      display: grid; place-items: center;
      font-weight: 900; margin-bottom: 20px;
    }

    .flow-step h3 { margin: 0 0 8px; font-size: 18px; }
    .flow-step p { margin: 0; color: var(--muted); font-size: 14px; }

    /* ── Mini phones (wireframe zone) ────────────── */
    .mockup-zone {
      display: grid; grid-template-columns: repeat(3,1fr);
      gap: 28px; align-items: start;
    }

    .mockup-zone-2 {
      display: grid; grid-template-columns: repeat(2,1fr);
      gap: 28px; align-items: start;
    }

    .mockup-zone-4 {
      display: grid; grid-template-columns: repeat(4,1fr);
      gap: 20px; align-items: start;
    }

    .mini-phone {
      border-radius: 34px; background: #111827;
      padding: 10px; box-shadow: var(--shadow);
    }

    .mini-screen {
      min-height: 560px; border-radius: 26px;
      background: linear-gradient(180deg, #fffdf7, #f3f7ef);
      padding: 16px; overflow: hidden;
    }

    .mini-screen.dark-screen {
      background: linear-gradient(180deg, #1a2332, #111827);
      color: #fff;
    }

    .topbar {
      display: flex; justify-content: space-between; align-items: center;
      margin-bottom: 20px; font-size: 13px; font-weight: 800;
    }

    .pill {
      border-radius: 999px; padding: 7px 10px;
      background: #eef3ea; color: var(--green-dark);
      font-size: 12px; font-weight: 850;
      display: inline-flex; gap: 6px; align-items: center;
    }

    .pill.coral { background: var(--coral-soft); color: var(--coral); }
    .pill.blue { background: var(--blue); color: var(--blue-mid); }
    .pill.purple { background: var(--purple); color: var(--purple-mid); }
    .pill.sun { background: var(--sun-soft); color: #b8860b; }
    .pill.dark { background: rgba(255,255,255,.12); color: rgba(255,255,255,.8); }

    .phone-h2 {
      font-size: 27px; line-height: 1.03; letter-spacing: -0.05em;
      margin: 0 0 8px;
    }

    .phone-h3 {
      font-size: 20px; line-height: 1.1; letter-spacing: -0.04em;
      margin: 0 0 6px; font-weight: 800;
    }

    .phone-p { color: var(--muted); font-size: 13px; margin: 0 0 18px; }

    .option-card {
      background: #fff; border: 1px solid var(--line);
      border-radius: 20px; padding: 14px; margin-bottom: 10px;
      display: flex; gap: 12px; align-items: center;
      box-shadow: 0 7px 16px rgba(31,41,51,.04);
      transition: border-color .15s;
    }
    .option-card.selected { border-color: rgba(63,143,114,.42); background: #f7fffb; }
    .option-card .emoji { font-size: 23px; width: 34px; text-align: center; }
    .option-card strong { display: block; font-size: 14px; }
    .option-card span { display: block; color: var(--muted); font-size: 12px; }

    .slider-card {
      background: #fff; border: 1px solid var(--line);
      border-radius: 22px; padding: 16px; margin-bottom: 14px;
    }

    .slider-head {
      display: flex; justify-content: space-between;
      font-size: 13px; font-weight: 850; margin-bottom: 12px;
    }

    .slider {
      height: 9px; border-radius: 999px; background: #e8ebe4;
      position: relative;
    }
    .slider:before {
      content: ""; position: absolute; left: 0; top: 0; bottom: 0;
      width: 58%; border-radius: 999px; background: var(--green);
    }
    .slider:after {
      content: ""; position: absolute; left: 56%; top: 50%;
      width: 22px; height: 22px; border-radius: 50%;
      transform: translateY(-50%);
      background: #fff; border: 5px solid var(--green);
      box-shadow: 0 8px 16px rgba(63,143,114,.24);
    }

    .slider.w40:before { width: 40%; }
    .slider.w40:after { left: 38%; }
    .slider.w75:before { width: 75%; }
    .slider.w75:after { left: 73%; }

    .cta-full {
      margin-top: 18px; width: 100%; padding: 14px;
      border-radius: 18px; background: var(--green);
      color: #fff; font-weight: 900; text-align: center;
      box-shadow: 0 14px 24px rgba(63,143,114,.24);
    }

    .cta-full.outline {
      background: transparent; color: var(--green);
      border: 2px solid var(--green);
      box-shadow: none; margin-top: 10px;
    }

    .cta-full.coral-bg { background: var(--coral); box-shadow: 0 14px 24px rgba(255,107,107,.24); }
    .cta-full.sun-bg { background: #e6a817; box-shadow: 0 14px 24px rgba(249,199,79,.3); }

    /* ── Child screens ───────────────────────────── */
    .child-screen { text-align: center; padding-top: 26px; }

    .child-hero {
      width: 112px; height: 112px; border-radius: 34px;
      display: grid; place-items: center; font-size: 58px;
      margin: 20px auto 22px;
    }

    .child-hero.green-glow {
      background: linear-gradient(135deg, var(--mint), #b4e8d0);
      box-shadow: 0 18px 26px rgba(63,143,114,.22);
    }
    .child-hero.sun-glow {
      background: linear-gradient(135deg, var(--sun), #ffecd1);
      box-shadow: 0 18px 26px rgba(249,199,79,.28);
    }
    .child-hero.purple-glow {
      background: linear-gradient(135deg, var(--purple), #d4bff9);
      box-shadow: 0 18px 26px rgba(155,107,230,.22);
    }
    .child-hero.coral-glow {
      background: linear-gradient(135deg, var(--peach), #ffb8a8);
      box-shadow: 0 18px 26px rgba(255,107,107,.22);
    }

    .question-card {
      background: #fff; border: 1px solid var(--line);
      border-radius: 26px; padding: 20px; text-align: left;
      margin-top: 20px; box-shadow: var(--shadow-soft);
    }

    .big-question {
      font-size: 24px; line-height: 1.1; letter-spacing: -0.04em;
      font-weight: 900; margin: 12px 0 16px;
    }

    .answer-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

    .answer {
      border-radius: 17px; border: 1px solid var(--line);
      background: #fbfaf6; padding: 15px; text-align: center;
      font-size: 22px; font-weight: 900;
    }
    .answer.good { background: var(--mint); border-color: rgba(63,143,114,.28); }

    /* ── Breathing animation ─────────────────────── */
    .breath-ring {
      width: 140px; height: 140px; border-radius: 50%;
      background: radial-gradient(circle, var(--mint) 40%, rgba(63,143,114,.15) 70%, transparent 100%);
      display: grid; place-items: center;
      margin: 24px auto;
      animation: breathe 4s ease-in-out infinite;
    }
    .breath-ring .inner {
      width: 80px; height: 80px; border-radius: 50%;
      background: #fff; display: grid; place-items: center;
      font-size: 14px; font-weight: 800; color: var(--green-dark);
      box-shadow: 0 8px 20px rgba(63,143,114,.15);
    }

    @keyframes breathe {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.12); }
    }

    /* ── Drawing canvas ──────────────────────────── */
    .canvas-area {
      border: 2px dashed var(--line); border-radius: 20px;
      height: 160px; margin: 16px 0;
      display: grid; place-items: center;
      color: var(--muted); font-size: 13px; font-weight: 700;
      background: rgba(255,255,255,.6);
    }

    .color-dots {
      display: flex; gap: 10px; justify-content: center; margin: 12px 0;
    }
    .color-dot {
      width: 28px; height: 28px; border-radius: 50%;
      border: 3px solid #fff; box-shadow: 0 4px 10px rgba(0,0,0,.1);
    }
    .color-dot.active { border-color: var(--ink); transform: scale(1.15); }

    /* ── Timer ring ──────────────────────────────── */
    .timer-ring {
      width: 130px; height: 130px; border-radius: 50%;
      border: 8px solid #e8ebe4; display: grid; place-items: center;
      margin: 24px auto; position: relative;
    }
    .timer-ring::before {
      content: ""; position: absolute; inset: -8px;
      border-radius: 50%; border: 8px solid var(--green);
      border-right-color: transparent; border-bottom-color: transparent;
      transform: rotate(45deg);
    }
    .timer-ring .time {
      font-size: 28px; font-weight: 900; letter-spacing: -0.04em;
    }
    .timer-ring .time-label {
      font-size: 11px; color: var(--muted); font-weight: 700;
    }

    /* ── Dashboard ───────────────────────────────── */
    .dashboard { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 24px; }

    .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }

    .stat {
      background: #fff; border: 1px solid var(--line);
      border-radius: 22px; padding: 18px;
      box-shadow: var(--shadow-card);
    }
    .stat .value {
      font-size: 34px; font-weight: 950; letter-spacing: -0.05em;
    }
    .stat .label { color: var(--muted); font-size: 13px; font-weight: 700; }

    .insight-list {
      background: #fff; border: 1px solid var(--line);
      border-radius: var(--radius-lg); padding: 18px;
      box-shadow: var(--shadow-card);
    }

    .insight {
      display: flex; gap: 12px; padding: 14px 0;
      border-bottom: 1px solid #edf0e9;
    }
    .insight:last-child { border-bottom: 0; }
    .insight b { display: block; margin-bottom: 3px; }
    .insight span { color: var(--muted); font-size: 14px; }

    /* ── Coach ───────────────────────────────────── */
    .coach {
      background: #17231f; color: #fff;
      border-radius: var(--radius-xl); padding: 30px;
      display: grid; grid-template-columns: .95fr 1.05fr;
      gap: 28px; align-items: center;
      box-shadow: var(--shadow); overflow: hidden;
      position: relative;
    }
    .coach:before {
      content: ""; position: absolute;
      width: 340px; height: 340px; border-radius: 50%;
      background: rgba(63,143,114,.32);
      right: -90px; top: -110px;
    }
    .coach h2 { color: #fff; }
    .coach p { color: rgba(255,255,255,.72); font-size: 17px; }

    .chat {
      position: relative;
      background: rgba(255,255,255,.08);
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 28px; padding: 18px;
      backdrop-filter: blur(12px);
    }

    .bubble {
      max-width: 86%; border-radius: 19px;
      padding: 13px 14px; margin-bottom: 12px; font-size: 14px;
    }
    .bubble.user { background: rgba(255,255,255,.16); margin-left: auto; }
    .bubble.ai { background: #fff; color: var(--ink); }

    /* ── Grade bank ──────────────────────────────── */
    .grade-scroll {
      display: flex; gap: 14px; overflow-x: auto;
      padding-bottom: 12px; scroll-snap-type: x mandatory;
    }

    .grade-card {
      flex: 0 0 220px; scroll-snap-align: start;
      background: #fff; border: 1px solid var(--line);
      border-radius: var(--radius-lg); overflow: hidden;
      box-shadow: var(--shadow-card);
    }

    .grade-card .grade-header {
      padding: 16px 18px; color: #fff; font-weight: 900; font-size: 15px;
    }
    .grade-card .grade-header span {
      display: block; font-weight: 600; font-size: 12px;
      opacity: .8; margin-top: 2px;
    }

    .grade-card .grade-body {
      padding: 14px 18px; font-size: 13px; color: var(--muted); line-height: 1.6;
    }

    .grade-card .grade-body strong {
      display: block; color: var(--ink); font-size: 12px;
      margin-top: 8px; margin-bottom: 2px;
    }

    /* ── Tab bar (in-phone) ──────────────────────── */
    .tab-bar {
      display: flex; justify-content: space-around;
      padding: 10px 0 4px; margin-top: 14px;
      border-top: 1px solid #edf0e9; font-size: 10px; font-weight: 700;
    }
    .tab-bar .tab { text-align: center; color: var(--muted); }
    .tab-bar .tab.active { color: var(--green); }
    .tab-bar .tab-icon { font-size: 18px; display: block; margin-bottom: 2px; }

    /* ── Dividers ────────────────────────────────── */
    .divider {
      height: 1px; background: var(--line); margin: 20px 0;
    }

    /* ── Footer ──────────────────────────────────── */
    .footer {
      margin-top: 80px; padding: 30px;
      border-radius: var(--radius-xl);
      background: rgba(255,255,255,.7);
      border: 1px solid var(--line);
      display: flex; justify-content: space-between;
      gap: 24px; align-items: center;
    }
    .footer strong { font-size: 24px; letter-spacing: -0.04em; }
    .footer span { color: var(--muted); }

    /* ── Phone label ─────────────────────────────── */
    .phone-label {
      text-align: center; margin-top: 16px;
      font-size: 13px; font-weight: 800; color: var(--muted);
      letter-spacing: .02em;
    }

    /* ── Inline stat row inside phone ────────────── */
